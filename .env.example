ENV=dev
DATABASE_URL=postgresql+asyncpg://app:app@localhost:15432/newmedia
REDIS_URL=redis://localhost:16379/0
JWT_SECRET=change-me-to-32-plus-random-chars
JWT_EXPIRE_MINUTES=720
MASTER_KEY=change-me-to-a-long-random-passphrase
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin12345
CORS_ORIGINS=http://localhost:5173
# 对象存储：local（默认，写入 OUTPUTS_DIR）或 s3（AWS S3 / MinIO / COS S3 网关）
STORAGE_BACKEND=local
# STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# STORAGE_S3_BUCKET=newmedia
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=
# STORAGE_S3_PREFIX=
# STORAGE_S3_USE_SSL=false
# STORAGE_S3_PATH_STYLE=true
# 画像记忆语义检索：填写向量模型名即启用，复用默认 OpenAI 兼容提供商；留空则按权重排序
# EMBEDDING_MODEL=text-embedding-v3
