ENV=dev
DATABASE_URL=postgresql+asyncpg://app:app@localhost:15432/newmedia
REDIS_URL=redis://localhost:16379/0
JWT_SECRET=change-me-to-32-plus-random-chars
JWT_EXPIRE_MINUTES=720
MASTER_KEY=change-me-to-a-long-random-passphrase
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin12345
CORS_ORIGINS=http://localhost:5173
# 对象存储：local（默认，写入 OUTPUTS_DIR）或 s3（AWS S3 / MinIO / COS S3 网关）
STORAGE_BACKEND=local
# STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# STORAGE_S3_BUCKET=newmedia
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=
# STORAGE_S3_PREFIX=
# STORAGE_S3_USE_SSL=false
# STORAGE_S3_PATH_STYLE=true
# 画像记忆语义检索：填写向量模型名即启用，复用默认 OpenAI 兼容提供商；留空则按权重排序
# EMBEDDING_MODEL=text-embedding-v3
# 登录限流：同一邮箱 / 同一 IP 在窗口内允许的失败次数（Redis 共享计数）
LOGIN_RATE_LIMIT_EMAIL=5
LOGIN_RATE_LIMIT_IP=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# 审计日志保留天数：到期先归档到对象存储 _audit_archive 再删除；<=0 关闭
AUDIT_RETENTION_DAYS=180
# Agent 运行时：步数/工具/Tokens/时长默认值与上限，租户当日 token 配额，审批有效期（小时），心跳超时（秒）
AGENT_MAX_STEPS_DEFAULT=12
AGENT_MAX_STEPS_CEILING=30
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_SECONDS=300
AGENT_TOKEN_BUDGET_DEFAULT=60000
AGENT_DAILY_TOKEN_QUOTA=500000
AGENT_APPROVAL_TTL_HOURS=24
# 心跳超时秒数：worker 对账时把心跳早于该时长的 running 运行重新入队（或终结）
AGENT_RUN_STALE_SECONDS=300
# 团队（第 3 层）：编排轮数/返工上限/黑板注入条数、团队预算默认值与硬上限
AGENT_TEAM_MAX_TURNS=12
AGENT_TEAM_REWORK_LIMIT=2
AGENT_TEAM_BLACKBOARD_INJECT=12
AGENT_TEAM_MAX_TOKENS=120000
AGENT_TEAM_MAX_TOOL_CALLS=40
AGENT_TEAM_MAX_SECONDS=900
AGENT_TEAM_TOKEN_CEILING=200000
AGENT_TEAM_SECONDS_CEILING=1800
# 工作流引擎：单次运行并行节点上限、单次推进时间片（秒，<=0 关闭）、运行墙钟上限（秒）、审批有效期（小时）、每用户活跃运行上限、心跳超时（秒）
WORKFLOW_MAX_PARALLEL_NODES=3
WORKFLOW_TIME_SLICE_SECONDS=480
WORKFLOW_MAX_SECONDS=3600
WORKFLOW_APPROVAL_TTL_HOURS=24
WORKFLOW_MAX_ACTIVE_RUNS_PER_USER=2
WORKFLOW_RUN_STALE_SECONDS=300
